{
  "name": "illumenate-yaml-builder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "schema": "python ../fixture_builder/catalog_schema.py",
    "schema:check": "python ../fixture_builder/catalog_schema.py --check",
    "predev": "npm run schema",
    "dev": "vite",
    "prebuild": "npm run schema:check",
    "build": "vite build",
    "build:erp": "npm run schema:check && vite build --config vite.erp.config.js",
    "test": "node --test tests/*.test.js",
    "test:render": "node tests/render.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7"
  }
}
