    "@radix-ui/react-tabs": "1.1.21",
    "ag-grid-community": "36.2.0",
    "ag-grid-react": "36.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dexie": "4.4.6",
    "immer": "11.1.18",
    "jszip": "3.10.2",
    "lucide-react": "1.48.0",
    "papaparse": "5.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
