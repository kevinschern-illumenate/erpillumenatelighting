{
  "doctype": "DocType",
  "name": "ilL-Account-Request",
  "module": "ilLumenate Lighting",
  "autoname": "hash",
  "engine": "InnoDB",
  "track_changes": 1,
  "field_order": [
    "request_type",
    "requested_by",
    "customer",
    "state",
    "reference_type",
    "reference_name",
    "expected_modified",
    "proposed_json",
    "request_key",
    "request_hash",
    "staff_note",
    "responses_json",
    "assigned_to",
    "reviewed_by",
    "reviewed_on"
  ],
  "fields": [
    {
      "fieldname": "request_type",
      "fieldtype": "Select",
      "label": "Request Type",
      "read_only": 1,
      "options": "Dealer application\nCompany linkage\nProfile change\nAccount closure\nAddress change\nContact change",
      "in_list_view": 1
    },
    {
      "fieldname": "requested_by",
      "fieldtype": "Link",
      "label": "Requested By",
      "read_only": 1,
      "options": "User",
      "in_list_view": 1
    },
    {
      "fieldname": "customer",
      "fieldtype": "Link",
      "label": "Customer",
      "read_only": 1,
      "options": "Customer",
      "in_list_view": 1
    },
    {
      "fieldname": "state",
      "fieldtype": "Select",
      "label": "State",
      "read_only": 1,
      "options": "Pending\nInformation needed\nApproved\nRejected\nResolved",
      "in_list_view": 1
    },
    {
      "fieldname": "reference_type",
      "fieldtype": "Link",
      "label": "Reference Type",
      "read_only": 1,
      "options": "DocType"
    },
    {
      "fieldname": "reference_name",
      "fieldtype": "Dynamic Link",
      "label": "Reference Name",
      "read_only": 1,
      "options": "reference_type"
    },
    {
      "fieldname": "expected_modified",
      "fieldtype": "Data",
      "label": "Expected Modified",
      "read_only": 1
    },
    {
      "fieldname": "proposed_json",
      "fieldtype": "Code",
      "label": "Proposed Json",
      "read_only": 1
    },
    {
      "fieldname": "request_key",
      "fieldtype": "Data",
      "label": "Request Key",
      "read_only": 1,
      "unique": 1,
      "hidden": 1
    },
    {
      "fieldname": "request_hash",
      "fieldtype": "Data",
      "label": "Request Hash",
      "read_only": 1
    },
    {
      "fieldname": "staff_note",
      "fieldtype": "Small Text",
      "label": "Staff Note",
      "read_only": 1
    },
    {
      "fieldname": "responses_json",
      "fieldtype": "Code",
      "label": "Responses Json",
      "read_only": 1
    },
    {
      "fieldname": "assigned_to",
      "fieldtype": "Link",
      "label": "Assigned To",
      "read_only": 1,
      "options": "User"
    },
    {
      "fieldname": "reviewed_by",
      "fieldtype": "Link",
      "label": "Reviewed By",
      "read_only": 1,
      "options": "User"
    },
    {
      "fieldname": "reviewed_on",
      "fieldtype": "Datetime",
      "label": "Reviewed On",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "report": 1
    },
    {
      "role": "All",
      "read": 1,
      "report": 1
    },
    {
      "role": "ilL Sales Review",
      "read": 1,
      "report": 1
    },
    {
      "role": "ilL Order Approver",
      "read": 1,
      "report": 1
    },
    {
      "role": "ilL Support",
      "read": 1,
      "report": 1
    }
  ]
}
