{
 "doctype": "DocType",
 "name": "ilL-Meeting-Agenda-Item",
 "module": "ilLumenate Lighting",
 "autoname": "hash",
 "engine": "InnoDB",
 "description": "One item on a meeting agenda, optionally linked to the record it is about.",
 "field_order": [
  "agenda",
  "item_title",
  "details",
  "column_break_1",
  "status",
  "presenter",
  "sort_order",
  "section_break_ref",
  "reference_doctype",
  "reference_name",
  "carried_from",
  "section_break_outcome",
  "outcome"
 ],
 "fields": [
  {
   "fieldname": "agenda",
   "fieldtype": "Link",
   "label": "Agenda",
   "options": "ilL-Meeting-Agenda",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "search_index": 1
  },
  {
   "fieldname": "item_title",
   "fieldtype": "Data",
   "label": "Item",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "details",
   "fieldtype": "Small Text",
   "label": "Details"
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Open\nDiscussed\nCarried over",
   "default": "Open",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "presenter",
   "fieldtype": "Link",
   "label": "Who brings it",
   "options": "User"
  },
  {
   "fieldname": "sort_order",
   "fieldtype": "Int",
   "label": "Order",
   "default": "0"
  },
  {
   "fieldname": "section_break_ref",
   "fieldtype": "Section Break",
   "label": "Linked record"
  },
  {
   "fieldname": "reference_doctype",
   "fieldtype": "Link",
   "label": "Record Type",
   "options": "DocType"
  },
  {
   "fieldname": "reference_name",
   "fieldtype": "Dynamic Link",
   "label": "Record",
   "options": "reference_doctype"
  },
  {
   "fieldname": "carried_from",
   "fieldtype": "Link",
   "label": "Carried Over From",
   "options": "ilL-Meeting-Agenda-Item",
   "read_only": 1
  },
  {
   "fieldname": "section_break_outcome",
   "fieldtype": "Section Break",
   "label": "Outcome"
  },
  {
   "fieldname": "outcome",
   "fieldtype": "Small Text",
   "label": "Outcome / decision"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "share": 1,
   "email": 1
  }
 ],
 "title_field": "item_title",
 "sort_field": "sort_order",
 "sort_order": "ASC",
 "track_changes": 1
}
