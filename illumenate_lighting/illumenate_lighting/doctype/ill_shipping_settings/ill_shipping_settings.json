   "fieldname": "section_labels",
   "fieldtype": "Section Break",
   "label": "EasyPost Labels"
  },
  {
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "Enabled",
   "default": "0",
   "description": "Create Labels and Void Label refuse while this is off. Create Shipment and tracking updates work either way."
  },
  {
   "fieldname": "label_webhook_url",
   "fieldtype": "Data",
