  },
  {
   "fieldname": "webhook_secret",
   "fieldtype": "Password",
   "label": "Webhook Shared Secret (HMAC)",
   "description": "Signs requests both ways (X-ilL-Signature = HMAC-SHA256 hex over the raw body). Store the same value in the n8n variable SHIPPING_WEBHOOK_SECRET. shipping_webhook_secret in site_config.json takes precedence."
  },
  {
   "fieldname": "column_break_labels",
   "fieldtype": "Column Break"
  },
