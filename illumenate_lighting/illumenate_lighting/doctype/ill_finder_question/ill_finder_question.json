  {
   "fieldname": "facet",
   "fieldtype": "Select",
   "label": "Product Fact",
   "options": "\nfamily\napplication\nenvironment_rating\nip_rating\nlight_type\ncolor_mode\ncct\ncct_range\ncri_min\nlumens_per_ft\nmounting_method\nlens_appearance\nfinish\ndimming_protocol\noutput_voltage\ndriver_wattage\ncontroller_type\nchannels\nzones\nwireless_protocol\ncontroller_mounting",
