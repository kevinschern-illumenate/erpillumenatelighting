  {
   "fieldname": "column_break_matching",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "unknown_policy",
   "fieldtype": "Select",
   "label": "When A Product Has No Data",
   "options": "Use default\nVerify\nExclude\nInclude silently",
   "default": "Use default",
   "depends_on": "facet",
   "description": "Verify keeps the product with a 'needs a quick check with our team' warning."
  },
  {
   "fieldname": "relax_priority",
   "fieldtype": "Int",
   "label": "Relax Priority",
   "depends_on": "eval:doc.match_mode=='Soft'",
   "description": "When nothing matches, soft questions are relaxed from the lowest number up."
  },
  {
   "fieldname": "verification_reason_template",
   "fieldtype": "Data",
   "label": "Verification Reason",
   "depends_on": "facet",
