{
 "doctype": "DocType",
 "name": "ilL-Publish-Job",
 "module": "ilLumenate Lighting",
 "autoname": "hash",
 "engine": "InnoDB",
 "track_changes": 1,
 "field_order": [
  "product",
  "listing_doctype",
  "listing_name",
  "brand",
  "publication",
  "operation",
  "revision_hash",
  "payload_json",
  "payload_hash",
  "request_key",
  "requested_by",
  "started_by",
  "template_status",
  "webflow_status",
  "effective_status",
  "state",
  "attempts",
  "lease_token",
  "lease_expires",
  "next_attempt_on",
  "remote_item_id",
  "result_json",
  "last_error",
  "completed_on"
 ],
 "fields": [
  {
   "fieldname": "product",
   "fieldtype": "Link",
   "label": "Product",
   "read_only": 1,
   "in_list_view": 1,
   "reqd": 1,
   "options": "ilL-Webflow-Product"
  },
  {
   "fieldname": "listing_doctype",
   "fieldtype": "Link",
   "label": "Listing DocType",
   "options": "DocType",
   "read_only": 1,
   "description": "Template (or Webflow Product) that holds this listing's web content."
  },
  {
   "fieldname": "listing_name",
   "fieldtype": "Dynamic Link",
   "label": "Listing",
   "options": "listing_doctype",
   "read_only": 1
  },
  {
   "fieldname": "brand",
   "fieldtype": "Link",
   "label": "Brand",
   "read_only": 1,
   "in_list_view": 1,
   "reqd": 1,
   "options": "ilL-Webflow-Brand"
  },
  {
   "fieldname": "publication",
   "fieldtype": "Link",
   "label": "Publication",
   "read_only": 1,
   "reqd": 1,
   "options": "ilL-Product-Publication"
  },
  {
   "fieldname": "operation",
   "fieldtype": "Select",
   "label": "Operation",
   "read_only": 1,
   "reqd": 1,
   "in_list_view": 1,
   "options": "STAGE\nPUBLISH\nRETIRE"
  },
  {
   "fieldname": "revision_hash",
   "fieldtype": "Data",
   "label": "Revision Hash",
   "read_only": 1,
   "reqd": 1
  },
  {
   "fieldname": "payload_json",
   "fieldtype": "Long Text",
   "label": "Payload Json",
   "read_only": 1,
   "reqd": 1
  },
  {
   "fieldname": "payload_hash",
   "fieldtype": "Data",
   "label": "Payload Hash",
   "read_only": 1,
   "reqd": 1
  },
  {
   "fieldname": "request_key",
   "fieldtype": "Data",
   "label": "Request Key",
   "read_only": 1,
   "unique": 1,
   "reqd": 1
  },
  {
   "fieldname": "requested_by",
   "fieldtype": "Link",
   "label": "Requested By",
   "read_only": 1,
   "options": "User"
  },
  {
   "fieldname": "started_by",
   "fieldtype": "Link",
   "label": "Started By",
   "read_only": 1,
   "options": "User",
   "description": "Who started this push (the button, or the save behind an automatic push). Gets the success notification."
  },
  {
   "fieldname": "template_status",
   "fieldtype": "Data",
   "label": "Template Status",
   "read_only": 1,
   "description": "The template's Product Status when the push was requested."
  },
  {
   "fieldname": "webflow_status",
   "fieldtype": "Data",
   "label": "Webflow Status",
   "read_only": 1,
   "description": "The product's Webflow Status when the push was requested."
  },
  {
   "fieldname": "effective_status",
   "fieldtype": "Data",
   "label": "Sent As",
   "read_only": 1,
   "description": "The status Webflow got (the template's status can override the product's, plan 4.3)."
  },
  {
   "fieldname": "state",
   "fieldtype": "Select",
   "label": "State",
   "read_only": 1,
   "default": "QUEUED",
   "in_list_view": 1,
   "options": "QUEUED\nRUNNING\nCOMPLETE\nFAILED\nSUPERSEDED"
  },
  {
   "fieldname": "attempts",
   "fieldtype": "Int",
   "label": "Attempts",
   "read_only": 1
  },
  {
   "fieldname": "lease_token",
   "fieldtype": "Data",
   "label": "Lease Token",
   "read_only": 1
  },
  {
   "fieldname": "lease_expires",
   "fieldtype": "Datetime",
   "label": "Lease Expires",
   "read_only": 1
  },
  {
   "fieldname": "next_attempt_on",
   "fieldtype": "Datetime",
   "label": "Next Attempt On",
   "read_only": 1
  },
  {
   "fieldname": "remote_item_id",
   "fieldtype": "Data",
   "label": "Remote Item Id",
   "read_only": 1
  },
  {
   "fieldname": "result_json",
   "fieldtype": "Long Text",
   "label": "Result Json",
   "read_only": 1
  },
  {
   "fieldname": "last_error",
   "fieldtype": "Small Text",
   "label": "Last Error",
   "read_only": 1
  },
  {
   "fieldname": "completed_on",
   "fieldtype": "Datetime",
   "label": "Completed On",
   "read_only": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "report": 1
  },
  {
   "role": "ilL Catalog Publisher",
   "read": 1,
   "report": 1
  },
  {
   "role": "ilL Integration",
   "read": 1,
   "report": 1
  }
 ],
 "sort_field": "modified",
 "sort_order": "DESC"
}
