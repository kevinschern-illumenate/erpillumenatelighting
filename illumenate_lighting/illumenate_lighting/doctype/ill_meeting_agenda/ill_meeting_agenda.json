{
 "doctype": "DocType",
 "name": "ilL-Meeting-Agenda",
 "module": "ilLumenate Lighting",
 "autoname": "format:MTG-{meeting_date}-{##}",
 "engine": "InnoDB",
 "description": "One weekly meeting. Its items are ilL-Meeting-Agenda-Item records. Edited from the Command Center Agenda tab.",
 "field_order": [
  "title",
  "meeting_date",
  "column_break_1",
  "status",
  "section_break_notes",
  "notes"
 ],
 "fields": [
  {
   "fieldname": "title",
   "fieldtype": "Data",
   "label": "Title",
   "reqd": 1,
   "default": "Weekly meeting",
   "in_list_view": 1
  },
  {
   "fieldname": "meeting_date",
   "fieldtype": "Date",
   "label": "Meeting Date",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Open\nClosed",
   "default": "Open",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "section_break_notes",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "notes",
   "fieldtype": "Small Text",
   "label": "Meeting Notes"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "share": 1,
   "email": 1
  }
 ],
 "title_field": "title",
 "show_title_field_in_link": 1,
 "sort_field": "meeting_date",
 "sort_order": "DESC",
 "track_changes": 1
}
