      "fieldtype": "Link",
      "label": "Project",
      "read_only": 1,
      "options": "ilL-Project"
    },
    {
      "fieldname": "access_level",
      "fieldtype": "Select",
      "label": "Access Level",
      "read_only": 1,
      "options": "VIEW\nEDIT"
    },
    {
      "fieldname": "email",
      "fieldtype": "Data",
      "label": "Email",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "first_name",
      "fieldtype": "Data",
      "label": "First Name",
      "read_only": 1
    },
    {
      "fieldname": "last_name",
      "fieldtype": "Data",
      "label": "Last Name",
      "read_only": 1
    },
    {
      "fieldname": "invited_by",
      "fieldtype": "Link",
      "label": "Invited By",
      "read_only": 1,
