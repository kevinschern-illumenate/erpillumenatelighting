  {
   "fieldname": "status_guide",
   "fieldtype": "HTML",
   "options": "<p>The pill at the top of the sidebar shows the status for the brand chosen in the Webflow publication section.</p><table class=\"table table-bordered\"><thead><tr><th style=\"width: 200px;\">Pill</th><th>Means</th></tr></thead><tbody><tr><td><span class=\"indicator-pill orange\">Needs staging</span></td><td>Never staged: it is not in Webflow yet. Approve and Stage to send it.</td></tr><tr><td><span class=\"indicator-pill orange\">Changes not staged</span></td><td>Edited since it was staged or live. Approve and Stage again to send the changes.</td></tr><tr><td><span class=\"indicator-pill blue\">Queued</span></td><td>A job is waiting for the n8n workflow to pick it up.</td></tr><tr><td><span class=\"indicator-pill yellow\">Staged</span></td><td>A draft in Webflow, not public. Publish Live to make it public.</td></tr><tr><td><span class=\"indicator-pill green\">Live</span></td><td>Published on the Webflow site.</td></tr><tr><td><span class=\"indicator-pill red\">Failed</span></td><td>The last Webflow job failed. See the Webflow publication section for the error, then Retry.</td></tr><tr><td><span class=\"indicator-pill gray\">Retired</span></td><td>Unpublished and archived in Webflow. The ERP record is kept.</td></tr></tbody></table>"
  }
