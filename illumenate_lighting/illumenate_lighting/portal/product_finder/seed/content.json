{
 "version": 1,
 "glossary": [
  {
   "term_key": "indoor_outdoor",
   "label": "Indoor vs. Outdoor",
   "tooltip": "Where the fixture lives sets the baseline weather and ingress protection it must survive.",
   "learn_more": "Indoor locations are typically Dry rated, however, you will be able to select Damp or Wet if needed for fixtures located in restrooms or similar. Outdoor locations always need at least Damp protection, and most need Wet / IP67+ because they face rain, sprinklers, snow, or wash-down.",
   "references": "ilL-Attribute-Environment Rating, ilL-Attribute-IP Rating"
  },
  {
   "term_key": "environment_rating",
   "label": "Environment Rating",
   "tooltip": "How much moisture the location exposes the fixture to: Dry, Damp, or Wet.",
   "learn_more": "Dry = conditioned interiors, no condensation. Damp = covered exterior / bathrooms where moisture is present but not direct. Wet = direct water contact (rain, sprinklers, fountains). The rating drives which profiles, lenses, and tape are eligible.",
   "references": "ilL-Attribute-Environment Rating"
  },
  {
   "term_key": "wet_rating",
   "label": "Outdoor / Wet Rating",
   "tooltip": "Survives direct water contact such as rain, sprinklers, or wash-down.",
   "learn_more": "For outdoor installations, we recommend fully encapsulated IP67+ products that can survive rain and snow but are fully enclosed to also handle dirt and bugs.",
   "references": "ilL-Attribute-Environment Rating, ilL-Attribute-IP Rating"
  },
  {
   "term_key": "ip_rating",
   "label": "IP Rating",
   "tooltip": "A two-digit code that rates how well an enclosure resists solids (dust, debris) and liquids (water).",
   "learn_more": "IP65 — Dust tight and protected against water jets, but not submersion. IP67 — Dust tight and can be temporarily submerged up to 1 meter for 30 minutes. IP68 — Dust tight and rated for continuous submersion beyond 1 meter at manufacturer-specified depth.",
   "references": "ilL-Attribute-IP Rating"
  },
  {
   "term_key": "light_type",
   "label": "Light Type",
   "tooltip": "The color behavior of the LED: static white, tunable white, dim-to-warm, or full color.",
   "learn_more": "Static white = one fixed CCT (e.g., 3000K). Tunable white = blends between two CCTs (e.g., 1800K to 4000K). Dim-to-warm = warms as it dims (like halogen / incandescent). Full-color = RGB / RGBW and addressable pixels.",
   "references": "led_package"
  },
  {
   "term_key": "color_mode",
   "label": "Color Mode",
   "tooltip": "How full-color tape is driven: one color for the whole run, or individually addressable pixels.",
   "learn_more": "Analog RGB / RGBW drives the whole strip to a single color at once. Addressable pixel (SPI) controls each pixel for chases, gradients, and video effects — and requires a DMX/SPI controller.",
   "references": "ilL-Attribute-Dimming Protocol"
  },
  {
   "term_key": "fixture_purpose",
   "label": "Fixture Purpose",
   "tooltip": "What the light is used for — this will help determine the lumens/ft of the fixture.",
   "learn_more": "Accent picks out an object or edge (lower output). Task lights a work surface (medium output). Ambient fills a room (higher output).",
   "references": ""
  },
  {
   "term_key": "installation_method",
   "label": "Installation Method",
   "tooltip": "How the fixture mounts to the building.",
   "learn_more": "Surface mounts onto a finished face. Recessed sits inside a routed channel. Angled aims light from a corner. Drywall / plaster-in is mudded flush for a trimless look. Suspended hangs from cables. This selects the profile family.",
   "references": "mounting_method"
  },
  {
   "term_key": "target_cct",
   "label": "Color Temperature (CCT)",
   "tooltip": "Warmth of white light, measured in Kelvin (K).",
   "learn_more": "2700K is warm / residential, 3000K warm-neutral, 3500K neutral, 4000K cool / commercial. Tunable white products cover a range instead of one value.",
   "references": "ilL-Attribute-CCT"
  },
  {
   "term_key": "cri",
   "label": "CRI (Color Rendering)",
   "tooltip": "How accurately colors appear under the light, on a 0–100 scale.",
   "learn_more": "90+ is the standard for quality architectural lighting. 95+ is premium (galleries, retail, hospitality) but has limited availability in our current data — confirm before committing.",
   "references": "cri_typical, ilL-Attribute-CRI"
  },
  {
   "term_key": "run_length",
   "label": "Run Length",
   "tooltip": "Total continuous length of the lit run, in feet.",
   "learn_more": "Long runs can drop voltage and exceed a single supply's capacity. We compare your length against the tape's max single-feed run length to flag when power injection or multiple supplies are needed.",
   "references": "voltage_drop_max_run_length_ft"
  },
  {
   "term_key": "power_injection",
   "label": "Power Injection",
   "tooltip": "Feeding power at more than one point along a run.",
   "learn_more": "When a run exceeds the max single-feed length, or total watts exceed one supply, you inject power mid-run or add supplies to keep brightness even end-to-end. This is derived for you from watts/ft × length vs. driver capacity.",
   "references": "max_wattage, watts_per_foot"
  },
  {
   "term_key": "supply_voltage",
   "label": "Supply Voltage",
   "tooltip": "The input voltage feeding the tape or driver.",
   "learn_more": "24VDC is the common low-voltage tape standard. 120VAC line-voltage products have an integral or remote driver. The supply voltage must match the tape's input voltage and the driver's input type.",
   "references": "input_voltage, input_voltage_type"
  },
  {
   "term_key": "dimming_protocol",
   "label": "Dimming Protocol",
   "tooltip": "The control signal used to dim or color the fixture.",
   "learn_more": "0-10V, TRIAC, ELV, and DALI dim white light. DMX512 and SPI drive color / pixels. The tape, driver, and controller must all speak the same protocol. Addressable pixel runs force DMX or SPI.",
   "references": "ilL-Attribute-Dimming Protocol, supported_dimming_protocols"
  },
  {
   "term_key": "dimming_0_10v",
   "label": "0-10V Dimming",
   "tooltip": "An analog signal between 0 and 10 volts controls brightness. 10V = full output, 1V = dim-low, 0V = off.",
   "learn_more": "0-10V is the most common protocol in architectural LED lighting. The driver needs a dedicated 0-10V input; standard wall dimmers will not work without a 0-10V wall station. Supported by virtually all LED tape drivers in our catalog.",
   "references": "ilL-Attribute-Dimming Protocol"
  },
  {
   "term_key": "dimming_triac",
   "label": "TRIAC Dimming",
   "tooltip": "Phase-cut dimming that works with most standard wall dimmers — common for residential and retrofit 120VAC applications.",
   "learn_more": "TRIAC (also called Forward Phase dimming) clips the AC sine wave to reduce average power. Works with most standard incandescent-style wall dimmers. Best for 120VAC line-voltage products. Some LED drivers have a minimum-load threshold below which they may flicker — confirm driver compatibility.",
   "references": "ilL-Attribute-Dimming Protocol"
  },
  {
   "term_key": "dimming_elv",
   "label": "ELV Dimming",
   "tooltip": "Electronic Low Voltage dimming — also called Reverse Phase dimming. Smoother phase-cut than TRIAC for many LED loads.",
   "learn_more": "ELV removes the trailing edge of the AC waveform rather than the leading edge (TRIAC). Many modern LED drivers prefer ELV because it puts less stress on the switching circuitry, resulting in smoother dimming and fewer compatibility issues. Requires an ELV-compatible wall dimmer.",
   "references": "ilL-Attribute-Dimming Protocol"
  },
  {
   "term_key": "dimming_dali",
   "label": "DALI",
   "tooltip": "Digital Addressable Lighting Interface — a two-wire digital bus that can independently address up to 64 fixtures on one circuit.",
   "learn_more": "DALI (IEC 62386) is the premium protocol for commercial and architectural projects. Each device has a unique address so scenes, schedules, and occupancy responses can be programmed per fixture without re-wiring. Provides status feedback (lamp failure, power failure) back to the building management system. Requires a DALI controller and DALI-capable drivers.",
   "references": "ilL-Attribute-Dimming Protocol"
  },
  {
   "term_key": "dimming_dmx512",
   "label": "DMX512",
   "tooltip": "Industry-standard digital protocol for stage and architectural lighting. One universe = up to 512 channels of control.",
   "learn_more": "DMX512 (EIA-485) is used for color mixing, effects, and architectural dynamic lighting. A single DMX run (universe) can carry 512 channels; RGB tape uses 3 channels per zone, RGBW uses 4. Requires a DMX controller (hardware or software). Common for hospitality, retail, and entertainment-grade color installations.",
   "references": "ilL-Attribute-Dimming Protocol"
  },
  {
   "term_key": "dimming_spi",
   "label": "SPI (Addressable Pixel)",
   "tooltip": "High-speed serial protocol that gives each pixel its own IC chip — enables per-pixel chases, gradients, and video-mapped effects.",
   "learn_more": "SPI (e.g., WS2812B, SK6812, APA102) embeds a controller IC inside every pixel. Each pixel is independently addressable, so thousands of pixels can run different colors simultaneously. Requires an SPI-compatible pixel controller and appropriate power injection. This is automatically forced when you select Addressable Pixel in the Color Mode question.",
   "references": "ilL-Attribute-Dimming Protocol"
  },
  {
   "term_key": "diffuser",
   "label": "Diffuser / Lens",
   "tooltip": "The lens covering the LEDs — changes look and delivered brightness.",
   "learn_more": "Clear is brightest but shows dots. Frosted hides dots with a small light loss. White diffuses fully (more loss, no hotspots). Black is a stealth daytime look. Lower transmission means fewer delivered lumens.",
   "references": "lens_appearance, transmission"
  },
  {
   "term_key": "operating_temp",
   "label": "Operating Temperature",
   "tooltip": "The ambient temperature range at the install location.",
   "learn_more": "Extreme heat shortens LED life; extreme cold can affect some drivers. Tape operating temp is free-text in ERP, so this is optional and informational in the prototype.",
   "references": "operating_temp"
  },
  {
   "term_key": "finish",
   "label": "Finish",
   "tooltip": "The visible color / finish of the extrusion.",
   "learn_more": "Silver (mill / anodized), Black, and White are the common architectural finishes. Optional — it does not change the light, only the look of the channel.",
   "references": "ilL-Attribute-Finish"
  },
  {
   "term_key": "lumens_per_foot",
   "label": "Lumens per Foot",
   "tooltip": "Light output per foot of tape — a brightness measure.",
   "learn_more": "Higher lumens/ft = brighter. Our purpose bands (accent / task / ambient) map onto lumens/ft ranges to rank products by how close they are to your goal.",
   "references": "lumens_per_foot"
  },
  {
   "term_key": "product_family",
   "label": "Product type",
   "tooltip": "Each product type has its own configurator. Linear fixtures are complete lights built to length.",
   "learn_more": "Linear fixtures combine an aluminum channel, a lens and LED tape built to your exact length. LED tape and neon are flexible strips you install yourself. Extrusion kits are the channel and lens without the tape. Power supplies (drivers) and controllers run and dim the lights."
  },
  {
   "term_key": "power_supply",
   "label": "Power supply (driver)",
   "tooltip": "Converts building power to the low voltage LED products use, and often handles dimming.",
   "learn_more": "Size a power supply for the total watts it will run plus about 20% headroom, and match its output voltage and dimming input to the lights and controls."
  },
  {
   "term_key": "output_voltage",
   "label": "Output voltage",
   "tooltip": "The DC voltage the lights expect, printed on the tape or fixture spec sheet (usually 24V).",
   "learn_more": "Using the wrong voltage will either not light the product or damage it. Most ilLumenate tape and fixtures run on 24V DC."
  },
  {
   "term_key": "load_watts",
   "label": "Load (watts)",
   "tooltip": "The total power of everything on the supply: run length × watts per foot.",
   "learn_more": "Add about 20% headroom so the power supply is not run at its limit. Long runs may also need power fed at more than one point."
  },
  {
   "term_key": "controller_type",
   "label": "Controller type",
   "tooltip": "How people will turn the lights on, dim them or change color.",
   "learn_more": "Wall dimmers and keypads suit simple rooms. Wireless receivers work with apps and remotes. DMX controllers drive color-changing and show lighting."
  },
  {
   "term_key": "channels",
   "label": "Channels",
   "tooltip": "Independent signals a controller sends: one for single white, two for tunable white, three or four for color.",
   "learn_more": "A controller must have at least as many channels as the light needs in each zone."
  },
  {
   "term_key": "zones",
   "label": "Zones",
   "tooltip": "Groups of lights that are switched or dimmed together.",
   "learn_more": "Each zone can be set independently. Count the areas that need their own control."
  }
 ],
