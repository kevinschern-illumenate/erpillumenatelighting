      "id": "erpnext-bill-webhook",
      "name": "ERPNext Bill Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "erpnext-purchase-invoice-bills",
      "notes": "Put this node's PRODUCTION URL in ilL-QBO-Settings → Bill Webhook URL. ERPNext posts a signed event when a Purchase Invoice is submitted or cancelled, and resends unlinked invoices hourly."
    },
    {
      "parameters": {
        "jsCode": "// ERPNext signs the raw body: X-QBO-Signature = hex HMAC-SHA256 with the shared secret.\nconst crypto = require('crypto');\nconst secret = $vars.QBO_WEBHOOK_SECRET; // same value as ilL-QBO-Settings.webhook_secret\nif (!secret) throw new Error('QBO_WEBHOOK_SECRET is not configured');\n\nconst item = $input.first();\nconst rawBody = item.binary && item.binary.data\n  ? Buffer.from(item.binary.data.data, 'base64')\n  : Buffer.from(JSON.stringify(item.json.body || {}), 'utf8');\nconst headers = item.json.headers || {};\nconst provided = String(headers['x-qbo-signature'] || headers['X-QBO-Signature'] || '').toLowerCase();\nconst expected = crypto.createHmac('sha256', secret).update(rawBody).digest('hex');\n\nconst a = Buffer.from(provided);\nconst b = Buffer.from(expected);\nif (a.length !== b.length || !crypto.timingSafeEqual(a, b)) {\n  throw new Error('Invalid X-QBO-Signature — dropping event');\n}\nreturn [{ json: JSON.parse(rawBody.toString('utf8')) }];"
      },
      "id": "verify-erpnext-signature",
      "name": "Verify ERPNext Signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        250,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "is-cancel",
              "leftValue": "={{ $json.event }}",
              "rightValue": "Cancel",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "is-cancel",
      "name": "Is Cancel?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        500,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://quickbooks.api.intuit.com/v3/company/{{ $vars.QBO_REALM_ID }}/query?query={{ encodeURIComponent(\"select Id, SyncToken from Bill where DocNumber = '\" + String($json.purchase_invoice).replace(/\\\\/g, '\\\\\\\\').replace(/'/g, \"\\\\'\") + \"'\") }}&minorversion=70",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "quickBooksOAuth2Api",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
