      "id": "find-bill-to-delete",
      "name": "Find Bill to Delete",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        750,
        -200
      ],
      "notes": "QuickBooks refuses to delete a Bill that has payments applied; the failed execution is the signal to sort it out in QuickBooks."
    },
    {
      "parameters": {
        "jsCode": "const bill = (($input.item.json.QueryResponse || {}).Bill || [])[0];\nif (!bill) return []; // never reached QuickBooks: nothing to delete\nreturn { json: { Id: String(bill.Id), SyncToken: String(bill.SyncToken) } };"
      },
