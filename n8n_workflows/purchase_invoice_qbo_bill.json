    },
    {
      "parameters": {
        "jsCode": "const plan = $input.item.json;\nreturn {\n  json: { purchase_invoice: plan.purchase_invoice, qbo_bill_id: plan.existing_bill_id, vendor_qbo_id: plan.vendor_id },\n};"
      },
      "id": "link-existing",
      "name": "Link Existing Bill",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2500,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Sign the exact JSON string sent to ERPNext.\nconst crypto = require('crypto');\nconst secret = $vars.QBO_WEBHOOK_SECRET;\nif (!secret) throw new Error('QBO_WEBHOOK_SECRET is not configured');\nreturn $input.all().map(item => {\n  const body = JSON.stringify(item.json);\n  const signature = crypto.createHmac('sha256', secret).update(body, 'utf8').digest('hex');\n  return { json: { body, signature, purchase_invoice: item.json.purchase_invoice } };\n});"
      },
      "id": "sign-link",
      "name": "Sign Link (HMAC)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3250,
        150
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://illumenatelighting.v.frappe.cloud/api/method/illumenate_lighting.illumenate_lighting.api.qbo_bills.receive_bill_link",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-QBO-Signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "string",
        "body": "={{ $json.body }}",
        "options": {}
      },
      "id": "post-link",
      "name": "Write Ids to ERPNext",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3500,
        150
      ],
      "notes": "Guest + HMAC endpoint; fails on non-2xx, which an n8n error workflow can alert on. Until this succeeds the invoice stays in Portal Operations → Bills not in QuickBooks and ERPNext resends it hourly."
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://quickbooks.api.intuit.com/v3/company/{{ $vars.QBO_REALM_ID }}/query?query={{ encodeURIComponent($json.qbo_bill_id ? \"select Id, SyncToken from Bill where Id = '\" + String($json.qbo_bill_id).replace(/\\\\/g, '\\\\\\\\').replace(/'/g, \"\\\\'\") + \"'\" : \"select Id, SyncToken from Bill where DocNumber = '\" + String($json.purchase_invoice).replace(/\\\\/g, '\\\\\\\\').replace(/'/g, \"\\\\'\") + \"'\") }}&minorversion=70",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "quickBooksOAuth2Api",
        "sendHeaders": true,
        "headerParameters": {
