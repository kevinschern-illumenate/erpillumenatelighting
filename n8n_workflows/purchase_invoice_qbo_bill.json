              "responseFormat": "json"
            }
          }
        }
      },
      "id": "find-bill",
      "name": "Find Bill",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        750,
        150
      ],
      "notes": "The Bill's DocNumber is the Purchase Invoice name, so a resend finds the Bill it already created. Set n8n variable QBO_REALM_ID to the company id. For a sandbox company use https://sandbox-quickbooks.api.intuit.com."
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://quickbooks.api.intuit.com/v3/company/{{ $vars.QBO_REALM_ID }}/query?query={{ encodeURIComponent($('Verify ERPNext Signature').item.json.vendor_qbo_id ? \"select Id from Vendor where Id = '\" + String($('Verify ERPNext Signature').item.json.vendor_qbo_id).replace(/\\\\/g, '\\\\\\\\').replace(/'/g, \"\\\\'\") + \"'\" : \"select Id from Vendor where DisplayName = '\" + String($('Verify ERPNext Signature').item.json.supplier_name).replace(/\\\\/g, '\\\\\\\\').replace(/'/g, \"\\\\'\") + \"'\") }}&minorversion=70",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "quickBooksOAuth2Api",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "response": {
