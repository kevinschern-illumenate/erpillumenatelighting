      "parameters": {
        "jsCode": "const plan = $('Build Bill').item.json.plan;\nreturn {\n  json: { purchase_invoice: plan.purchase_invoice, qbo_bill_id: String($input.item.json.Bill.Id), vendor_qbo_id: plan.vendor_id },\n};"
      },
