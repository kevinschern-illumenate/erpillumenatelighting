        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ DisplayName: $json.supplier_name, CompanyName: $json.supplier_name }) }}"
      },
      "id": "create-vendor",
      "name": "Create Vendor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1750,
        300
      ],
      "notes": "A supplier not yet in QuickBooks becomes a Vendor with the same display name. Its id is written back to the ERPNext Supplier."
    },
    {
      "parameters": {
        "jsCode": "return { json: { ...$('Plan Bill').item.json, vendor_id: String($input.item.json.Vendor.Id) } };"
      },
      "id": "take-new-vendor",
      "name": "Take New Vendor",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "bill-exists",
              "leftValue": "={{ $json.existing_bill_id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "bill-exists",
      "name": "Bill Exists?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        2250,
        150
      ]
    },
    {
      "parameters": {
        "jsCode": "// QuickBooks Bill from the ERPNext lines. Expense account ids are n8n variables:\n// QBO_BILL_EXPENSE_ACCOUNT_ID for item lines, QBO_BILL_ADJUSTMENT_ACCOUNT_ID (optional)\n// for taxes, charges and rounding, so the Bill total equals the Purchase Invoice total.\nconst pi = $input.item.json;\nconst expense = $vars.QBO_BILL_EXPENSE_ACCOUNT_ID;\nif (!expense) throw new Error('QBO_BILL_EXPENSE_ACCOUNT_ID is not configured');\nconst adjustmentAccount = $vars.QBO_BILL_ADJUSTMENT_ACCOUNT_ID || expense;\n\nconst line = (amount, description, account) => ({\n  DetailType: 'AccountBasedExpenseLineDetail',\n  Amount: Math.round(amount * 100) / 100,\n  Description: String(description).slice(0, 4000),\n  AccountBasedExpenseLineDetail: { AccountRef: { value: String(account) } },\n});\nconst lines = (pi.lines || [])\n  .filter(l => Number(l.amount) !== 0)\n  .map(l => line(Number(l.amount), `${l.item_code}: ${l.description} × ${l.qty}`, expense));\nif (Number(pi.adjustment) !== 0) lines.push(line(Number(pi.adjustment), 'Taxes, charges and rounding', adjustmentAccount));\nif (!lines.length) throw new Error(`Purchase Invoice ${pi.purchase_invoice} has no amounts to bill`);\nif (lines.some(l => l.Amount < 0)) throw new Error(`Purchase Invoice ${pi.purchase_invoice} has a negative line; enter this bill in QuickBooks by hand`);\n\nconst bill = {\n  VendorRef: { value: pi.vendor_id },\n  TxnDate: pi.posting_date,\n  DocNumber: pi.purchase_invoice,\n  PrivateNote: `ERPNext ${pi.purchase_invoice}${pi.bill_no ? `; supplier invoice ${pi.bill_no}` : ''}`,\n  Line: lines,\n};\nif (pi.due_date) bill.DueDate = pi.due_date;\nreturn { json: { bill, plan: pi } };"
      },
      "id": "build-bill",
      "name": "Build Bill",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2500,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://quickbooks.api.intuit.com/v3/company/{{ $vars.QBO_REALM_ID }}/bill?minorversion=70",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "quickBooksOAuth2Api",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            },
            {
              "name": "Content-Type",
