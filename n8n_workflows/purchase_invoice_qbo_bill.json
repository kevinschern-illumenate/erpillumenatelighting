              "responseFormat": "json"
            }
          }
        }
      },
      "id": "find-vendor",
      "name": "Find Vendor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1000,
        150
      ]
    },
    {
      "parameters": {
        "jsCode": "// Decide what still has to happen in QuickBooks for this Purchase Invoice.\nconst pi = $('Verify ERPNext Signature').item.json;\nconst bill = (($('Find Bill').item.json.QueryResponse || {}).Bill || [])[0];\nconst vendor = (($input.item.json.QueryResponse || {}).Vendor || [])[0];\nreturn {\n  json: {\n    ...pi,\n    existing_bill_id: bill ? String(bill.Id) : null,\n    vendor_id: vendor ? String(vendor.Id) : null,\n  },\n};"
      },
      "id": "plan-bill",
      "name": "Plan Bill",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1250,
        150
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "vendor-found",
              "leftValue": "={{ $json.vendor_id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "vendor-found",
      "name": "Vendor Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1500,
        150
